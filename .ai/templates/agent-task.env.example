# Documentation-only example. tools.agent_task generates unique local values; do not copy a production env file.
COMPOSE_PROJECT_NAME=sp-agent-example
COMPOSE_PROFILES=
APP_IMAGE=senior-pomidor-server:agent
LAN_BIND_ADDRESS=127.0.0.1
POSTGRES_BIND_ADDRESS=127.0.0.1
API_PUBLISHED_PORT=22000
MQTT_PUBLISHED_PORT=22001
POSTGRES_PUBLISHED_PORT=22002
GRAFANA_PUBLISHED_PORT=22003
OLLAMA_PUBLISHED_PORT=22004
POSTGRES_DB=agent_22000
POSTGRES_USER=agent_local
POSTGRES_PASSWORD=agent_local_22000
GRAFANA_DB_USER=agent_grafana
GRAFANA_DB_PASSWORD=agent_grafana_22000
GRAFANA_ADMIN_USER=agent_admin
GRAFANA_ADMIN_PASSWORD=agent_admin_22000
DATABASE_URL=postgresql+psycopg://agent_local:agent_local_22000@postgres:5432/agent_22000
PHOTO_DATA_DIR=./.agent-tasks/example/data/photos
ESTIMATOR_PRIVATE_DATA_DIR=./.agent-tasks/example/data/estimator-private
MOSQUITTO_DATA_DIR=./.agent-tasks/example/data/mosquitto
POSTGRES_DATA_DIR=./.agent-tasks/example/data/postgres
GRAFANA_DATA_DIR=./.agent-tasks/example/data/grafana
OLLAMA_DATA_DIR=./.agent-tasks/example/data/ollama
GRAFANA_CLOUD_EXPORT_ENABLED=false
GRAFANA_CLOUD_REMOTE_WRITE_URL=
GRAFANA_CLOUD_INSTANCE_ID=
GRAFANA_CLOUD_API_TOKEN=
EXECUTOR_BACKEND=fake
HARDWARE_BACKEND=fake
GPIO_ENABLED=false
AGENT_TASK_ISOLATED=true
