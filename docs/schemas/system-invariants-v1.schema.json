{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "senior-pomidor.system-invariants.v1",
  "title": "Senior Pomidor system invariants report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at_utc", "status", "core", "edge", "scenarios"],
  "properties": {
    "schema_version": {"const": "senior-pomidor.system-invariants.v1"},
    "generated_at_utc": {"$ref": "#/$defs/utcTimestamp"},
    "status": {"$ref": "#/$defs/status"},
    "core": {"$ref": "#/$defs/revision"},
    "edge": {"$ref": "#/$defs/revision"},
    "scenarios": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/scenario"}}
  },
  "$defs": {
    "status": {"enum": ["PASS", "FAIL", "NOT_RUN"]},
    "utcTimestamp": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["git_sha", "image_ref", "image_digest"],
      "properties": {
        "git_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "image_ref": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "@sha256:[0-9a-f]{64}$"},
        "image_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generated", "persisted", "read_back", "duplicates", "missing", "unknown"],
      "properties": {
        "generated": {"type": "integer", "minimum": 0},
        "persisted": {"type": "integer", "minimum": 0},
        "read_back": {"type": "integer", "minimum": 0},
        "duplicates": {"type": "integer", "minimum": 0},
        "missing": {"type": "integer", "minimum": 0},
        "unknown": {"type": "integer", "minimum": 0}
      }
    },
    "alert": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "expected", "observed", "status"],
      "properties": {
        "rule_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$"},
        "expected": {"enum": ["FIRING", "NOT_FIRING", "NO_DATA", "RECOVERED", "NOT_RUN"]},
        "observed": {"enum": ["FIRING", "NOT_FIRING", "NO_DATA", "RECOVERED", "NOT_RUN"]},
        "status": {"$ref": "#/$defs/status"}
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenario_id", "applicability", "evidence_scope", "started_at_utc", "finished_at_utc", "status", "counts", "alert_outcomes", "notes"],
      "properties": {
        "scenario_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$"},
        "applicability": {"enum": ["IMPLEMENTED", "NOT_IMPLEMENTED"]},
        "evidence_scope": {"enum": ["SYNTHETIC", "CI", "STAGING", "REHEARSAL", "CANARY", "PRODUCTION"]},
        "started_at_utc": {"$ref": "#/$defs/utcTimestamp"},
        "finished_at_utc": {"$ref": "#/$defs/utcTimestamp"},
        "status": {"$ref": "#/$defs/status"},
        "counts": {"$ref": "#/$defs/counts"},
        "alert_outcomes": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/alert"}},
        "notes": {"type": "array", "maxItems": 20, "items": {"type": "string", "minLength": 1, "maxLength": 256}}
      }
    }
  }
}
