{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "senior-pomidor.edge.telemetry.v2",
  "type": "object",
  "required": ["schema_version", "device_id", "timestamp_utc"],
  "properties": {
    "schema_version": {"const": "senior-pomidor.edge.telemetry.v2"},
    "record_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "device_id": {"type": "string"},
    "timestamp_utc": {"type": "string", "pattern": "Z$"},
    "pods": {"type": ["array", "object"]},
    "pod_readings": {"type": ["array", "object"]},
    "plant": {"type": "object"},
    "system_health": {
      "type": "object",
      "properties": {
        "aggregate": {
          "type": "object",
          "required": ["schema_version", "state"],
          "properties": {
            "schema_version": {"const": "senior-pomidor.edge.health.v1"},
            "state": {"enum": ["STARTUP", "OK", "BACKLOG", "DEGRADED", "MAINTENANCE", "CRITICAL"]},
            "reasons": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 256}, "maxItems": 32, "uniqueItems": true}
          },
          "additionalProperties": true
        },
        "rpi_core": {"type": "object"},
        "pod_1_hardware": {"type": "object"},
        "errors": {"type": "array"},
        "network": {
          "type": "object",
          "properties": {
            "wifi_connected": {"type": "boolean"},
            "interface_up": {"type": "boolean"},
            "default_gateway_reachable": {"type": "boolean"},
            "dns_resolution_ok": {"type": "boolean"},
            "internet_reachable": {"type": "boolean"},
            "active_profile_present": {"type": "boolean"},
            "preferred_profile_present": {"type": "boolean"},
            "ssid": {"type": "string"},
            "ip_address": {"type": "string"},
            "last_recovery_action": {"type": "string"},
            "last_recovery_result": {"type": "string"},
            "last_recovery_at_utc": {"type": "string"},
            "wifi_profile_count": {"type": "integer"},
            "last_recovery_exit_code": {"type": "integer"}
          },
          "additionalProperties": true
        },
        "watchdog": {
          "type": "object",
          "properties": {
            "state": {"$ref": "#/$defs/nullableBoundedString"},
            "reason": {"$ref": "#/$defs/nullableBoundedString"},
            "result": {"$ref": "#/$defs/nullableBoundedString"},
            "suppression": {"type": "boolean"},
            "configured": {"type": "boolean"},
            "attempt_count": {"$ref": "#/$defs/nonnegativeInteger"},
            "restart_count": {"$ref": "#/$defs/nonnegativeInteger"},
            "reboot_count": {"$ref": "#/$defs/nonnegativeInteger"},
            "last_healthy_heartbeat_at_utc": {"$ref": "#/$defs/nullableUtcTimestamp"},
            "boot_id": {"$ref": "#/$defs/nullableBoundedString"}
          },
          "additionalProperties": true
        },
        "spool": {
          "type": "object",
          "properties": {
            "status": {"$ref": "#/$defs/nullableBoundedString"},
            "disk_status": {"$ref": "#/$defs/nullableBoundedString"},
            "pending_count": {"$ref": "#/$defs/nonnegativeInteger"},
            "backlog_count": {"$ref": "#/$defs/nonnegativeInteger"},
            "in_flight_count": {"$ref": "#/$defs/nonnegativeInteger"},
            "delivered_count": {"$ref": "#/$defs/nonnegativeInteger"},
            "dead_letter_count": {"$ref": "#/$defs/nonnegativeInteger"},
            "reconciled_count": {"$ref": "#/$defs/nonnegativeInteger"},
            "resolution_total": {"$ref": "#/$defs/nonnegativeInteger"},
            "last_reconciliation_at_utc": {"$ref": "#/$defs/nullableUtcTimestamp"},
            "last_reconciliation_reason": {"$ref": "#/$defs/nullableBoundedString"},
            "oldest_pending_age_seconds": {"$ref": "#/$defs/nullableNonnegativeInteger"},
            "outage_duration_seconds": {"$ref": "#/$defs/nullableNonnegativeInteger"},
            "database_size_bytes": {"$ref": "#/$defs/nonnegativeInteger"},
            "free_space_bytes": {"$ref": "#/$defs/nonnegativeInteger"},
            "disk_usage_percent": {"type": "number", "minimum": 0, "maximum": 100},
            "delivery_attempt_count": {"$ref": "#/$defs/nonnegativeInteger"},
            "delivery_success_count": {"$ref": "#/$defs/nonnegativeInteger"},
            "duplicate_count": {"$ref": "#/$defs/nonnegativeInteger"},
            "delivery_retry_count": {"$ref": "#/$defs/nonnegativeInteger"},
            "delivery_rejected_count": {"$ref": "#/$defs/nonnegativeInteger"},
            "last_delivery_result": {"$ref": "#/$defs/nullableBoundedString"},
            "last_delivery_at_utc": {"$ref": "#/$defs/nullableUtcTimestamp"},
            "last_successful_delivery_at_utc": {"$ref": "#/$defs/nullableUtcTimestamp"},
            "last_error_code": {"$ref": "#/$defs/nullableBoundedString"},
            "last_error_at_utc": {"$ref": "#/$defs/nullableUtcTimestamp"},
            "write_failure_count": {"$ref": "#/$defs/nonnegativeInteger"},
            "written_total": {"$ref": "#/$defs/nonnegativeInteger"},
            "success_total": {"$ref": "#/$defs/nonnegativeInteger"},
            "failure_total": {"$ref": "#/$defs/nonnegativeInteger"},
            "duplicate_total": {"$ref": "#/$defs/nonnegativeInteger"},
            "replayed_total": {"$ref": "#/$defs/nonnegativeInteger"},
            "replay_count": {"$ref": "#/$defs/nonnegativeInteger"},
            "estimated_drain_seconds": {"$ref": "#/$defs/nullableNonnegativeNumber"},
            "estimated_retention_days": {"$ref": "#/$defs/nullableNonnegativeNumber"},
            "worker_state": {"$ref": "#/$defs/nullableBoundedString"},
            "worker_last_heartbeat_at_utc": {"$ref": "#/$defs/nullableUtcTimestamp"},
            "legacy_corrupt_count": {"$ref": "#/$defs/nonnegativeInteger"}
          },
          "additionalProperties": true
        },
        "application": {
          "type": "object",
          "allOf": [
            {
              "if": {"required": ["service_manager"], "properties": {"service_manager": {"const": "none"}}},
              "then": {
                "required": ["process_running"],
                "not": {
                  "anyOf": [
                    {"required": ["systemd_available"]},
                    {"required": ["systemd_service_name"]},
                    {"required": ["systemd_active_state"]},
                    {"required": ["systemd_sub_state"]},
                    {"required": ["systemd_service_active"]},
                    {"required": ["systemd_main_pid"]}
                  ]
                }
              }
            },
            {
              "if": {"required": ["service_manager"], "properties": {"service_manager": {"const": "systemd"}}},
              "then": {"required": ["process_running", "systemd_available", "systemd_service_active"]}
            }
          ],
          "properties": {
            "service_manager": {"enum": ["none", "systemd"]},
            "process_id": {"$ref": "#/$defs/nonnegativeInteger"},
            "process_running": {"type": "boolean"},
            "process_uptime_seconds": {"$ref": "#/$defs/nonnegativeInteger"},
            "process_memory_rss_bytes": {"$ref": "#/$defs/nonnegativeInteger"},
            "process_cpu_percent": {"type": "number", "minimum": 0},
            "systemd_available": {"type": "boolean"},
            "systemd_service_name": {"$ref": "#/$defs/nullableBoundedString"},
            "systemd_active_state": {"$ref": "#/$defs/nullableBoundedString"},
            "systemd_sub_state": {"$ref": "#/$defs/nullableBoundedString"},
            "systemd_service_active": {"type": "boolean"},
            "systemd_main_pid": {"$ref": "#/$defs/nonnegativeInteger"}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "$defs": {
    "nonnegativeInteger": {"type": "integer", "minimum": 0},
    "nullableNonnegativeInteger": {"type": ["integer", "null"], "minimum": 0},
    "nullableNonnegativeNumber": {"type": ["number", "null"], "minimum": 0},
    "nullableBoundedString": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
    "nullableUtcTimestamp": {
      "type": ["string", "null"],
      "maxLength": 256,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    }
  }
}
