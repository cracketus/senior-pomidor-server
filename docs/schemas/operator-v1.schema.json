{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://senior-pomidor.local/schemas/operator-v1.schema.json",
  "title": "Senior Pomidor private operator read model v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "view", "request_id", "generated_at_utc", "status", "availability", "freshness", "completeness", "reasons", "data"],
  "properties": {
    "schema_version": {"const": "senior-pomidor.operator.v1"},
    "view": {"enum": ["status", "plants", "edges", "anomalies", "photos", "decisions"]},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "generated_at_utc": {"type": "string", "format": "date-time"},
    "status": {"$ref": "#/$defs/status"}, "availability": {"$ref": "#/$defs/availability"},
    "freshness": {"$ref": "#/$defs/freshness"}, "completeness": {"$ref": "#/$defs/completeness"},
    "reasons": {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/reason"}},
    "data": {"type": "object"}
  },
  "allOf": [
    {"if": {"properties": {"view": {"const": "status"}}}, "then": {"properties": {"data": {"$ref": "#/$defs/status_data"}}}},
    {"if": {"properties": {"view": {"const": "plants"}}}, "then": {"properties": {"data": {"$ref": "#/$defs/plants_data"}}}},
    {"if": {"properties": {"view": {"const": "edges"}}}, "then": {"properties": {"data": {"$ref": "#/$defs/edges_data"}}}},
    {"if": {"properties": {"view": {"const": "anomalies"}}}, "then": {"properties": {"data": {"$ref": "#/$defs/anomalies_data"}}}},
    {"if": {"properties": {"view": {"const": "photos"}}}, "then": {"properties": {"data": {"$ref": "#/$defs/photos_data"}}}},
    {"if": {"properties": {"view": {"const": "decisions"}}}, "then": {"properties": {"data": {"$ref": "#/$defs/decisions_data"}}}}
  ],
  "$defs": {
    "status": {"enum": ["OK", "WARN", "ALERT", "UNKNOWN"]},
    "availability": {"enum": ["AVAILABLE", "UNAVAILABLE", "NOT_IMPLEMENTED"]},
    "freshness": {"enum": ["FRESH", "STALE", "UNKNOWN", "NOT_APPLICABLE"]},
    "completeness": {"enum": ["COMPLETE", "PARTIAL"]},
    "timestamp": {"type": "string", "format": "date-time"},
    "nullable_timestamp": {"anyOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]},
    "reason": {"type": "object", "additionalProperties": false, "required": ["code", "status", "message"], "properties": {"code": {"type": "string", "minLength": 1, "maxLength": 80}, "status": {"$ref": "#/$defs/status"}, "message": {"type": "string", "minLength": 1, "maxLength": 200}}},
    "host": {"type": "object", "additionalProperties": false, "required": ["availability", "status", "freshness", "reason"], "properties": {"availability": {"$ref": "#/$defs/availability"}, "status": {"$ref": "#/$defs/status"}, "freshness": {"$ref": "#/$defs/freshness"}, "reason": {"type": ["string", "null"]}}},
    "metrics": {"type": "object", "additionalProperties": false, "required": ["soil_moisture_percent", "soil_temperature_c", "air_temperature_c", "air_humidity_percent", "air_vpd_kpa", "light_lux"], "properties": {"soil_moisture_percent": {"type": ["number", "null"], "minimum": 0, "maximum": 100}, "soil_temperature_c": {"type": ["number", "null"]}, "air_temperature_c": {"type": ["number", "null"]}, "air_humidity_percent": {"type": ["number", "null"], "minimum": 0, "maximum": 100}, "air_vpd_kpa": {"type": ["number", "null"], "minimum": 0}, "light_lux": {"type": ["number", "null"], "minimum": 0, "maximum": 150000}}},
    "pod": {"type": "object", "additionalProperties": false, "required": ["pod_key", "plant_id", "plant_identity_status", "enabled", "observed_at_utc", "metrics"], "properties": {"pod_key": {"type": "string"}, "plant_id": {"type": ["string", "null"]}, "plant_identity_status": {"const": "UNKNOWN"}, "enabled": {"type": ["boolean", "null"]}, "observed_at_utc": {"$ref": "#/$defs/nullable_timestamp"}, "metrics": {"$ref": "#/$defs/metrics"}}},
    "plant": {"type": "object", "additionalProperties": false, "required": ["node_id", "observed_at_utc", "state_id", "pods"], "properties": {"node_id": {"type": "string"}, "observed_at_utc": {"$ref": "#/$defs/nullable_timestamp"}, "state_id": {"type": ["string", "null"]}, "pods": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/pod"}}}},
    "probe": {"type": "object", "additionalProperties": false, "required": ["id", "position", "moisture_pct", "dry_threshold_pct", "confidence", "status"], "properties": {"id": {"type": "string", "maxLength": 128}, "position": {"type": "string", "maxLength": 128}, "moisture_pct": {"type": ["number", "null"], "minimum": 0, "maximum": 100}, "dry_threshold_pct": {"type": ["number", "null"], "minimum": 0, "maximum": 100}, "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1}, "status": {"type": "string", "maxLength": 128}}},
    "state": {"type": "object", "additionalProperties": false, "required": ["state_id", "node_id", "observed_at_utc", "status", "confidence", "env", "soil", "plant"], "properties": {"state_id": {"type": "string"}, "node_id": {"type": "string"}, "observed_at_utc": {"$ref": "#/$defs/timestamp"}, "status": {"$ref": "#/$defs/status"}, "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1}, "env": {"type": "object", "additionalProperties": false, "required": ["air_temp_c", "rh_pct", "vpd_kpa", "lux"], "properties": {"air_temp_c": {"type": ["number", "null"]}, "rh_pct": {"type": ["number", "null"], "minimum": 0, "maximum": 100}, "vpd_kpa": {"type": ["number", "null"], "minimum": 0}, "lux": {"type": ["number", "null"], "minimum": 0, "maximum": 150000}}}, "soil": {"type": "object", "additionalProperties": false, "required": ["temp_c", "probes"], "properties": {"temp_c": {"type": ["number", "null"]}, "probes": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/probe"}}}}, "plant": {"type": "object", "additionalProperties": false, "required": ["leaf_temp_c"], "properties": {"leaf_temp_c": {"type": ["number", "null"]}}}}},
    "edge": {"$ref": "#/$defs/edge_object"},
    "edge_object": {"type": "object", "additionalProperties": false, "required": ["schema_version", "device_id", "record_id", "generated_at_utc", "observed_at_utc", "received_at_utc", "status", "freshness", "reasons", "watchdog", "spool", "application"], "properties": {"schema_version": {"const": "senior-pomidor.operator.edge-reliability.v1"}, "device_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9_.-]+$"}, "record_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9_.:-]+$"}, "generated_at_utc": {"type": "string", "format": "date-time"}, "observed_at_utc": {"$ref": "#/$defs/edge_nullable_timestamp"}, "received_at_utc": {"$ref": "#/$defs/edge_nullable_timestamp"}, "status": {"$ref": "#/$defs/edge_reliability_status"}, "freshness": {"$ref": "#/$defs/edge_freshness"}, "reasons": {"type": "array", "items": {"$ref": "#/$defs/edge_reason"}}, "watchdog": {"$ref": "#/$defs/edge_watchdog"}, "spool": {"$ref": "#/$defs/edge_spool"}, "application": {"$ref": "#/$defs/edge_application"}}},
    "edge_reliability_status": {"type": "string", "enum": ["OK", "WARN", "ALERT", "UNKNOWN"]},
    "edge_nullable_string": {"type": ["string", "null"]},
    "edge_nullable_boolean": {"type": ["boolean", "null"]},
    "edge_nullable_counter": {"type": ["integer", "null"], "minimum": 0},
    "edge_nullable_timestamp": {"type": ["string", "null"], "format": "date-time"},
    "edge_freshness": {"type": "object", "additionalProperties": false, "required": ["status", "age_seconds", "max_age_seconds"], "properties": {"status": {"type": "string", "enum": ["FRESH", "STALE", "UNKNOWN"]}, "age_seconds": {"type": ["number", "null"], "minimum": 0}, "max_age_seconds": {"const": 1200}}},
    "edge_reason": {"type": "object", "additionalProperties": false, "required": ["code", "status", "message"], "properties": {"code": {"type": "string", "minLength": 1}, "status": {"$ref": "#/$defs/edge_reliability_status"}, "message": {"type": "string", "minLength": 1}}},
    "edge_watchdog": {"type": "object", "additionalProperties": false, "required": ["status", "state", "result", "suppression", "configured", "attempt_count", "restart_count", "reboot_count", "last_healthy_heartbeat_at_utc"], "properties": {"status": {"$ref": "#/$defs/edge_reliability_status"}, "state": {"$ref": "#/$defs/edge_nullable_string"}, "result": {"$ref": "#/$defs/edge_nullable_string"}, "suppression": {"$ref": "#/$defs/edge_nullable_boolean"}, "configured": {"$ref": "#/$defs/edge_nullable_boolean"}, "attempt_count": {"$ref": "#/$defs/edge_nullable_counter"}, "restart_count": {"$ref": "#/$defs/edge_nullable_counter"}, "reboot_count": {"$ref": "#/$defs/edge_nullable_counter"}, "last_healthy_heartbeat_at_utc": {"$ref": "#/$defs/edge_nullable_timestamp"}}},
    "edge_spool": {"type": "object", "additionalProperties": false, "required": ["status", "reported_status", "disk_status", "pending_count", "backlog_count", "in_flight_count", "dead_letter_count", "oldest_pending_age_seconds", "outage_duration_seconds", "disk_usage_percent", "last_delivery_result", "last_successful_delivery_at_utc", "last_error_code", "worker_state", "worker_last_heartbeat_at_utc"], "properties": {"status": {"$ref": "#/$defs/edge_reliability_status"}, "reported_status": {"$ref": "#/$defs/edge_nullable_string"}, "disk_status": {"$ref": "#/$defs/edge_nullable_string"}, "pending_count": {"$ref": "#/$defs/edge_nullable_counter"}, "backlog_count": {"$ref": "#/$defs/edge_nullable_counter"}, "in_flight_count": {"$ref": "#/$defs/edge_nullable_counter"}, "dead_letter_count": {"$ref": "#/$defs/edge_nullable_counter"}, "oldest_pending_age_seconds": {"$ref": "#/$defs/edge_nullable_counter"}, "outage_duration_seconds": {"$ref": "#/$defs/edge_nullable_counter"}, "disk_usage_percent": {"type": ["number", "null"], "minimum": 0, "maximum": 100}, "last_delivery_result": {"$ref": "#/$defs/edge_nullable_string"}, "last_successful_delivery_at_utc": {"$ref": "#/$defs/edge_nullable_timestamp"}, "last_error_code": {"$ref": "#/$defs/edge_nullable_string"}, "worker_state": {"$ref": "#/$defs/edge_nullable_string"}, "worker_last_heartbeat_at_utc": {"$ref": "#/$defs/edge_nullable_timestamp"}}},
    "edge_application": {"type": "object", "additionalProperties": false, "required": ["status", "process_running", "process_uptime_seconds", "systemd_available", "systemd_active_state", "systemd_sub_state", "systemd_service_active"], "properties": {"status": {"$ref": "#/$defs/edge_reliability_status"}, "process_running": {"$ref": "#/$defs/edge_nullable_boolean"}, "process_uptime_seconds": {"$ref": "#/$defs/edge_nullable_counter"}, "systemd_available": {"$ref": "#/$defs/edge_nullable_boolean"}, "systemd_active_state": {"$ref": "#/$defs/edge_nullable_string"}, "systemd_sub_state": {"$ref": "#/$defs/edge_nullable_string"}, "systemd_service_active": {"$ref": "#/$defs/edge_nullable_boolean"}}},
    "status_data": {"type": "object", "additionalProperties": false, "required": ["host", "nodes", "state", "edge", "decisions"], "properties": {"host": {"$ref": "#/$defs/host"}, "nodes": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/plant"}}, "state": {"anyOf": [{"$ref": "#/$defs/state"}, {"type": "null"}]}, "edge": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/edge"}}, "decisions": {"$ref": "#/$defs/availability"}}},
    "collection_data": {"type": "object", "required": ["items", "returned_count", "has_more"], "properties": {"returned_count": {"type": "integer", "minimum": 0, "maximum": 100}, "has_more": {"type": "boolean"}}},
    "plants_data": {"allOf": [{"$ref": "#/$defs/collection_data"}, {"type": "object", "required": ["items"], "properties": {"items": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/plant"}}}}], "unevaluatedProperties": false},
    "edges_data": {"allOf": [{"$ref": "#/$defs/collection_data"}, {"type": "object", "required": ["items"], "properties": {"items": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/edge"}}}}], "unevaluatedProperties": false},
    "anomaly": {"type": "object", "additionalProperties": false, "required": ["anomaly_id", "node_id", "type", "status", "severity", "observed_at_utc", "state_id"], "properties": {"anomaly_id": {"type": "string"}, "node_id": {"type": "string"}, "type": {"type": "string"}, "status": {"type": "string"}, "severity": {"$ref": "#/$defs/status"}, "observed_at_utc": {"$ref": "#/$defs/timestamp"}, "state_id": {"type": ["string", "null"]}}},
    "anomalies_data": {"allOf": [{"$ref": "#/$defs/collection_data"}, {"type": "object", "required": ["items"], "properties": {"items": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/anomaly"}}}}], "unevaluatedProperties": false},
    "photo": {"type": "object", "additionalProperties": false, "required": ["photo_id", "node_id", "captured_at_utc", "content_type", "file_size_bytes", "sha256", "sharpness_score"], "properties": {"photo_id": {"type": "string"}, "node_id": {"type": "string"}, "captured_at_utc": {"$ref": "#/$defs/timestamp"}, "content_type": {"type": "string"}, "file_size_bytes": {"type": "integer", "minimum": 0}, "sha256": {"type": "string"}, "sharpness_score": {"type": ["number", "null"]}}},
    "photos_data": {"allOf": [{"$ref": "#/$defs/collection_data"}, {"type": "object", "required": ["items"], "properties": {"items": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/photo"}}}}], "unevaluatedProperties": false},
    "decisions_data": {"type": "object", "additionalProperties": false, "required": ["items"], "properties": {"items": {"type": "array", "maxItems": 100}}}
  }
}
