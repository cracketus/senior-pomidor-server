{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://senior-pomidor.example/schemas/health-summary-v1.schema.json",
  "title": "Senior Pomidor health summary v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "generated_at", "components", "reasons", "data_freshness"],
  "properties": {
    "schema_version": {"const": "health_summary_v1"},
    "status": {"enum": ["OK", "WARN", "ALERT", "UNKNOWN"]},
    "generated_at": {"type": "string", "format": "date-time"},
    "components": {
      "type": "object",
      "properties": {
        "edge_reliability": {"$ref": "#/$defs/edgeReliability"}
      },
      "additionalProperties": {"$ref": "#/$defs/component"}
    },
    "reasons": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": {"type": "string", "maxLength": 64},
          "message": {"type": "string", "maxLength": 160}
        }
      }
    },
    "data_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["worker_max_age_seconds", "telemetry_max_age_seconds", "node_id"],
      "properties": {
        "worker_max_age_seconds": {"type": "integer", "const": 90},
        "telemetry_max_age_seconds": {"type": "integer", "const": 1200},
        "node_id": {"type": ["string", "null"], "maxLength": 128}
      }
    }
  },
  "$defs": {
    "status": {"enum": ["OK", "WARN", "ALERT", "UNKNOWN"]},
    "component": {
      "type": "object",
      "additionalProperties": true,
      "required": ["status"],
      "properties": {
        "status": {"$ref": "#/$defs/status"},
        "age_seconds": {"type": "number", "minimum": 0},
        "scope": {"type": "string", "const": "server"},
        "migration": {"type": "string", "maxLength": 32},
        "reason_code": {"type": "string", "maxLength": 64}
      }
    },
    "edgeReliability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason_codes", "watchdog", "spool", "application"],
      "properties": {
        "status": {"$ref": "#/$defs/status"},
        "age_seconds": {"type": "number", "minimum": 0},
        "reason_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "maxLength": 64}
        },
        "watchdog": {"$ref": "#/$defs/watchdogReliability"},
        "spool": {"$ref": "#/$defs/spoolReliability"},
        "application": {"$ref": "#/$defs/applicationReliability"}
      }
    },
    "watchdogReliability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"$ref": "#/$defs/status"},
        "state": {"type": "string", "maxLength": 256},
        "result": {"type": ["string", "null"], "maxLength": 256},
        "suppression": {"type": "boolean"},
        "configured": {"type": "boolean"}
      }
    },
    "spoolReliability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"$ref": "#/$defs/status"},
        "reported_status": {"type": ["string", "null"], "maxLength": 256},
        "disk_status": {"type": ["string", "null"], "maxLength": 256}
      }
    },
    "applicationReliability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"$ref": "#/$defs/status"},
        "process_running": {"type": "boolean"},
        "systemd_available": {"type": "boolean"},
        "systemd_service_active": {"type": "boolean"}
      }
    }
  }
}
