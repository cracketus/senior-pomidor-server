          "pluginVersion": "12.0.0",
          "targets": [{"editorMode": "code", "expr": "max(senior_pomidor_edge_spool_disk_usage_percent)", "instant": false, "legendFormat": "", "range": true, "refId": "A"}],
          "title": "EDGE DISK",
