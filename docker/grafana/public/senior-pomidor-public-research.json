          "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}, "unit": "s"}, "overrides": []},
          "gridPos": {"h": 5, "w": 6, "x": 6, "y": 41},
          "id": 19,
          "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "showPercentChange": false, "textMode": "auto", "wideLayout": true},
          "pluginVersion": "12.0.0",
          "targets": [{"editorMode": "code", "expr": "max(senior_pomidor_edge_reliability_freshness_seconds)", "instant": false, "legendFormat": "", "range": true, "refId": "A"}],
          "title": "EDGE DATA AGE",
          "type": "stat"
        },
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "description": "Buffered telemetry records awaiting normal delivery.",
          "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}, "unit": "short"}, "overrides": []},
          "gridPos": {"h": 5, "w": 6, "x": 12, "y": 41},
          "id": 20,
          "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "showPercentChange": false, "textMode": "auto", "wideLayout": true},
          "pluginVersion": "12.0.0",
          "targets": [{"editorMode": "code", "expr": "sum(senior_pomidor_edge_spool_backlog_records)", "instant": false, "legendFormat": "", "range": true, "refId": "A"}],
          "title": "SPOOL BACKLOG",
          "type": "stat"
        },
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "description": "Disk usage reported through the bounded public edge reliability projection.",
          "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}, "unit": "percent"}, "overrides": []},
          "gridPos": {"h": 5, "w": 6, "x": 18, "y": 41},
